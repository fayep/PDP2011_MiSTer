	.title	tb_rsts_overlay - kernel APR-5 overlay window remapped under the clock

;  Phase 4.  Models the RSTS/E monitor overlay mechanism: monitor code
;  runs through kernel APR 5 (virtual 120000-137777); to invoke a
;  different overlay the monitor saves kI/kD PAR5, points them at the
;  overlay's physical page, JSRs into 120000, then restores PAR5 (the
;  wrapper at v.142600 on the hang).  The line clock ISR *also* remaps
;  APR 5, runs its own overlaid code, and restores - so PAR5 is being
;  saved/reloaded from two priority levels concurrently.
;
;  Each overlay writes its id to its OWN marker.  A correct core: every
;  caller sees the overlay it asked for.  A stale mapping (old physical
;  page used for a cycle after a PAR write, or kI/kD PAR5 briefly out of
;  sync) shows up as the wrong overlay running or a mem-management abort.
;
;  result(500):  1  = every window call ran the overlay it asked for  (PASS)
;               55  = a window call ran the WRONG overlay              (BUG)
;               44  = the clock ISR's own window call ran wrong        (BUG)
;               66  = memory-management trap
;                0  = wander / lockup                                  (HANG)

PSW	= 177776
MMR0	= 177572
MMR2	= 177576
MMR3	= 172516
KWCSR	= 177546
KIPAR0	= 172340
KIPAR5	= 172352
KIPDR0	= 172300
KDPAR0	= 172360
KDPAR5	= 172372
KDPDR0	= 172320

PAFA	= 1200			; overlay A -> physical page 120000
PAFB	= 1300			; overlay B -> physical page 130000
PAFD	= 1500			; overlay D -> physical page 150000 (clock ISR)
WIN	= 120000		; APR-5 window virtual address
NITER	= 800.

	.asect

	.=100
	.word	clkisr
	.word	4340
	.=250
	.word	mmtrap
	.word	340

	.=500
result:	.word	0
iter:	.word	0
ticks:	.word	0
wmarkA:	.word	0
wmarkB:	.word	0
wmarkD:	.word	0
mmr0v:	.word	0
mmr2v:	.word	0

	.=120000
ovlA:	mov	#1111,@#wmarkA
	rts	pc
	.=130000
ovlB:	mov	#2222,@#wmarkB
	rts	pc
	.=150000
ovlD:	mov	#4444,@#wmarkD
	rts	pc

	.=1000
start:
	mov	#4000,sp

	mov	#KIPAR0,r0
	clr	r1
	mov	#8.,r2
1$:	mov	r1,(r0)+
	add	#200,r1
	sob	r2,1$
	mov	#177600,@#172356

	mov	#KDPAR0,r0
	clr	r1
	mov	#8.,r2
2$:	mov	r1,(r0)+
	add	#200,r1
	sob	r2,2$
	mov	#177600,@#172376

	mov	#KIPDR0,r0
	mov	#8.,r2
3$:	mov	#77406,(r0)+
	sob	r2,3$
	mov	#KDPDR0,r0
	mov	#8.,r2
4$:	mov	#77406,(r0)+
	sob	r2,4$

	mov	#65,@#MMR3
	mov	#1,@#MMR0
	mov	#4240,@#PSW		; register set 1, priority 5

	clr	@#result
	clr	@#iter
	clr	@#ticks
	mov	#100,@#KWCSR

loop:
	clr	@#wmarkA
	mov	#PAFA,r5
	jsr	pc,@#callwin
	cmp	@#wmarkA,#1111
	bne	wrong

	clr	@#wmarkB
	mov	#PAFB,r5
	jsr	pc,@#callwin
	cmp	@#wmarkB,#2222
	bne	wrong

	inc	@#iter
	cmp	@#iter,#NITER
	blt	loop

	mov	#1,@#result
done:	br	done

wrong:	mov	#55,@#result
	halt

; ---- invoke overlay whose PAF is in r5 ----
callwin:
	mov	@#KIPAR5,-(sp)
	mov	r5,@#KIPAR5
	mov	r5,@#KDPAR5
	jsr	pc,@#WIN
	mov	(sp)+,@#KIPAR5
	mov	@#KIPAR5,@#KDPAR5
	rts	pc

; ---- line clock ISR : also drives the APR-5 window ----
clkisr:
	inc	@#ticks
	mov	r5,-(sp)
	mov	@#KIPAR5,-(sp)
	clr	@#wmarkD
	mov	#PAFD,@#KIPAR5
	mov	#PAFD,@#KDPAR5
	jsr	pc,@#WIN
	cmp	@#wmarkD,#4444
	bne	isrwrong
	mov	(sp)+,@#KIPAR5
	mov	@#KIPAR5,@#KDPAR5
	mov	(sp)+,r5
	rti
isrwrong:
	mov	#44,@#result
	halt

mmtrap:
	mov	@#MMR0,@#mmr0v
	mov	@#MMR2,@#mmr2v
	mov	#66,@#result
	halt

	.end	start
