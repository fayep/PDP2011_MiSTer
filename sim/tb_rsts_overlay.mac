	.title	tb_rsts_overlay - interrupt-driven RH70 read vs the line clock

;  Phase 3.  Phases 1-2 (polled read, then polled + full MMU + set 1)
;  both PASS - a polled read survives clock preemption.  This one runs
;  the RH70 read *interrupt driven* (CS1 IE = 1), the way a normal RSTS
;  disk request does, and spins on a software "done" flag that only the
;  BR5 completion ISR sets.  If an RH70 completion interrupt is lost
;  when it coincides with BR6 clock-interrupt activity, the flag is
;  never set and the wait loop spins forever.
;
;  MMU config matches the hardware hang (MMR3 = 65, kernel-D, kI PDR7
;  read-only), main runs in register set 1 at priority 5.
;
;  result(500):  1  = every sector's completion interrupt arrived (PASS)
;               77  = RH raised SC/error
;               66  = memory-management trap
;                0  = a completion interrupt was lost -> HANG

RHCS1	= 176700
RHWC	= 176702
RHBA	= 176704
RHDA	= 176706
RHDC	= 176734
RHBAE	= 176750
KWCSR	= 177546
PSW	= 177776
MMR0	= 177572
MMR2	= 177576
MMR3	= 172516
KIPAR0	= 172340
KIPDR0	= 172300
KDPAR0	= 172360
KDPDR0	= 172320

NSECT	= 6.

	.asect

	.=100				; line clock vector
	.word	clkisr
	.word	4340			; kernel set 1, priority 7
	.=250				; memory management vector
	.word	mmtrap
	.word	340
	.=254				; RH (BR5) vector
	.word	rhisr
	.word	4340			; kernel set 1, priority 7

	.=500
result:	.word	0
count:	.word	0
ticks:	.word	0
last:	.word	0
mmr0v:	.word	0
mmr2v:	.word	0
dflag:	.word	0			; set by rhisr, cleared before each read

	.=1000
start:
	mov	#4000,sp

	mov	#KIPAR0,r0
	clr	r1
	mov	#7.,r2
1$:	mov	r1,(r0)+
	add	#200,r1
	sob	r2,1$
	mov	#177600,(r0)

	mov	#KDPAR0,r0
	clr	r1
	mov	#7.,r2
2$:	mov	r1,(r0)+
	add	#200,r1
	sob	r2,2$
	mov	#177600,(r0)

	mov	#KIPDR0,r0
	mov	#7.,r2
3$:	mov	#77406,(r0)+
	sob	r2,3$
	mov	#77402,(r0)		; kI PDR7 read-only

	mov	#KDPDR0,r0
	mov	#8.,r2
4$:	mov	#77406,(r0)+
	sob	r2,4$

	mov	#65,@#MMR3
	mov	#1,@#MMR0
	mov	#4200,@#PSW		; register set 1, priority 4 (BR5 disk + BR6 clock both deliverable)

	clr	@#result
	clr	@#count
	clr	@#ticks
	mov	#100,@#KWCSR		; line clock interrupt enable
	clr	r4

kick:
	clr	@#RHBAE
	mov	#40000,@#RHBA
	clr	@#RHDC
	mov	r4,@#RHDA
	mov	#-400,@#RHWC
	clr	@#dflag
	mov	#171,@#RHCS1		; fnc = read data + GO + IE (bit 6)

wait:
	tst	@#dflag
	beq	wait			; spin until the completion ISR fires

	inc	r4
	inc	@#count
	cmp	r4,#NSECT
	blt	kick

	mov	#1,@#result
done:	br	done

; ---- RH completion ISR (BR5) ----
rhisr:
	mov	@#RHCS1,r0
	mov	r0,@#last
	bit	#100000,r0		; SC / error?
	bne	1$
	mov	#1,@#dflag
	rti
1$:	mov	#77,@#result
	halt

; ---- line clock ISR ----
clkisr:
	inc	@#ticks
	mov	#40,-(sp)
2$:	dec	(sp)
	bne	2$
	tst	(sp)+
	rti

; ---- memory-management trap ----
mmtrap:
	mov	@#MMR0,@#mmr0v
	mov	@#MMR2,@#mmr2v
	mov	#66,@#result
	halt

	.end	start
