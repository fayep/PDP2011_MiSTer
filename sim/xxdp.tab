# XXDP MAINDEC catalog for sim/run_xxdp.sh
# Fields, '|'-separated:
#   name | file in XXDP_ROOT | init_pc oct | cons_sw oct | pass_match | fail_match | fail_match2 | stop-time | budget
#
# cons_sw 104001 = SW15 halt-on-error + SW11 inhibit-iterations + SW00 skip operator (EKBAD0).
# ZMMCA0 uses 0 so the diagnostic takes default limits 2710-17470.
#
EKBAD0|EKBAD0.BIC|200|104001|END PASS|TEST NUMBER||20ms|2000000
ZMMCA0|ZMMCA0.BIC|200|0||WRITE-READ ERROR|DUAL ADDRESS ERROR|20ms|2000000
