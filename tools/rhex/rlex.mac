	.title	rlex - RL11/RL02 whole-pack exerciser: seeks, interrupts, reads and writes
;
; Standalone, booted from tape like rhex. Disk: any RL02 image on unit 0;
; it is formatted by this program.
; Pattern by cylinder c (0-511), head h (0-1), sector s (0-39), 128 words:
; word 0 = c, word 1 = h<<8 ! s, word w (2..127) =
; (w<<8 ! (c & 377)) ^ (h<<6 ! s) ^ 052525 ^ salt; salt 0 except on
; cylinders 0..WCYL-1 (the write area), kept per sector at SALTAB.
; The RL11 does no implied seek: every transfer reads the header (where
; the heads are), seeks by a signed difference with head select, then
; reads or writes 1..n sectors within the track.
; Per transfer (iter = number): every 4th a WRITE to the write area with a
; new salt, read back; iter&10: interrupt round (IE on every command,
; completion by the RL interrupt, vector 160, exactly one per command).
; Checks: CS ERR clear, CRDY/DRDY, BA advanced, DA sector field advanced,
; guard words, every word, the interrupt count. Status line every 1024.
;
	.asect
	.enabl	ama
	. = 0
	jmp	@#start
	. = 4
	.word	trap4, 340
	.word	trap10, 340
	. = 100
	.word	clkint, 340
	. = 160
	.word	rlint, 340
;
rlcs	= 174400
rlba	= 174402
rlda	= 174404
rlmp	= 174406
lks	= 177546
tps	= 177564
tpb	= 177566
psw	= 177776
;
NCYL	= 512.
NSEC	= 40.
WCYL	= 10.
SALTAB	= 150000		; WCYL*2*40 words
FBUF	= 20000
MAXN	= 20.
SENT	= 125125
FGST	= 4			; function codes in CS (fn<<1), CRDY 0 = go
FSEEK	= 6
FRHDR	= 10
FWRITE	= 12
FREAD	= 14
;
	. = 1000
start:	mov	#1000,sp
	reset
	mov	#hello,r0
	call	puts
	mov	#100,@#lks
	clr	@#psw
	clr	ie
	call	gstat			; reset drive errors
	clr	r1
	mov	#WCYL*80.,r3
1$:	clr	SALTAB(r1)
	add	#2,r1
	sob	r3,1$
;
; format unless the last sector checks out (write area always)
	mov	#NCYL-1,c
	mov	#1,h
	mov	#NSEC-1,s
	mov	#1,nblk
	mov	#FBUF,buf
	mov	#FREAD,fnc
	call	xfer
	tst	r0
	bne	2$
	call	verify
	tst	r0
	bne	2$
	mov	#mfquick,r0
	call	puts
	mov	#WCYL,ncf
	br	3$
2$:	mov	#mffull,r0
	call	puts
	mov	#NCYL,ncf
3$:	clr	c
4$:	clr	h
5$:	clr	s
	clr	salt
	mov	#FBUF,r2
	mov	#NSEC,r3
6$:	call	gen
	inc	s
	sob	r3,6$
	clr	s
	mov	#NSEC,nblk
	mov	#FBUF,buf
	mov	#FWRITE,fnc
	call	xfer
	tst	r0
	beq	7$
	mov	#mfail,r0
	call	puts
	call	regs
	halt
7$:	inc	h
	cmp	h,#2
	blo	5$
	bit	#77,c
	bne	8$
	mov	#mcyl,r0
	call	puts
	mov	c,r0
	call	puto
	call	crlf
8$:	inc	c
	cmp	c,ncf
	blo	4$
	mov	#mfdone,r0
	call	puts
;
loop:	add	#1,iterl
	adc	iterh
	call	rand			; buffer
	bic	#100001,r1
	add	#20000,r1
	mov	r1,buf
	clr	ie
	bit	#10,iterl
	beq	1$
	mov	#100,ie
1$:	call	rand			; head, sector
	bic	#177776,r1
	mov	r1,h
	call	rand
	clr	r0
	div	#NSEC,r0
	mov	r1,s
	mov	#NSEC,r1		; n = 1 .. min(MAXN, 40-s)
	sub	s,r1
	cmp	r1,#MAXN
	blos	2$
	mov	#MAXN,r1
2$:	mov	r1,r4
	call	rand
	clr	r0
	div	r4,r0
	inc	r1
	mov	r1,nblk
	mov	iterl,r1
	bic	#177774,r1
	cmp	r1,#3
	beq	wround
	call	rand			; read anywhere
	clr	r0
	div	#NCYL,r0
	mov	r1,c
	br	rround
wround:	call	rand
	clr	r0
	div	#WCYL,r0
	mov	r1,c
	call	rand
	bis	#1,r1
	mov	r1,nsalt
	mov	buf,r2
	mov	s,-(sp)
	mov	nblk,r3
1$:	call	slot
	mov	nsalt,SALTAB(r1)
	mov	nsalt,salt
	call	gen
	inc	s
	sob	r3,1$
	mov	(sp)+,s
	mov	#FWRITE,fnc
	call	xfer
	tst	r0
	beq	2$
	jmp	fail
2$:	inc	writes
	call	rand
	bic	#100001,r1
	add	#20000,r1
	mov	r1,buf
rround:	mov	buf,r2			; sentinel: buffer and guards
	sub	#4,r2
	mov	nblk,r3
	ash	#7,r3			; words
	add	#4,r3
1$:	mov	#SENT,(r2)+
	sob	r3,1$
	mov	#FREAD,fnc
	call	xfer
	tst	r0
	beq	2$
	jmp	fail
2$:	mov	buf,r2
	cmp	-4(r2),#SENT
	bne	3$
	cmp	-2(r2),#SENT
	bne	3$
	mov	nblk,r1
	ash	#8.,r1			; bytes
	add	r1,r2
	cmp	(r2),#SENT
	bne	3$
	cmp	2(r2),#SENT
	beq	4$
3$:	mov	#mgrd,r0
	jmp	fail
4$:	call	verify
	tst	r0
	beq	next
	jmp	fail
;
next:	mov	#2000,r0
1$:	sob	r0,1$
	cmp	rlints,expint
	beq	2$
	mov	#mint,r0
	mov	rlints,expint
	jmp	fail
2$:	bit	#1777,iterl
	bne	3$
	mov	#mstat,r0
	call	puts
	mov	iterh,r0
	call	puto
	mov	iterl,r0
	call	puto
	mov	#merr,r0
	call	puts
	mov	errs,r0
	call	puto
	mov	#mwr,r0
	call	puts
	mov	writes,r0
	call	puto
	mov	#mints,r0
	call	puts
	mov	rlints,r0
	call	puto
	mov	#mtick,r0
	call	puts
	mov	ticks,r0
	call	puto
	call	crlf
3$:	jmp	loop
;
; one command, CS function in r0 (plus ie), waits; r0 = 0 ok, else reason
cmd:	tst	ie
	beq	1$
	inc	expint
1$:	bis	ie,r0
	mov	r0,@#rlcs
	tst	ie
	beq	3$
	clr	r3			; wait for the interrupt
	mov	#100.,r4
2$:	mov	rlints,r0
	sub	expint,r0
	bpl	3$
	sob	r3,2$
	sob	r4,2$
	mov	#mitmo,r0
	return
3$:	clr	r3			; (and/or) poll CRDY
	mov	#100.,r4
4$:	tstb	@#rlcs
	bmi	5$
	sob	r3,4$
	sob	r4,4$
	mov	#mtmo,r0
	return
5$:	tst	@#rlcs			; ERR
	bpl	6$
	mov	#merr1,r0
	return
6$:	clr	r0
	return
;
gstat:	mov	#13,@#rlda		; get status with reset
	mov	#FGST,r0
	jmp	cmd
;
; xfer: read header, seek to c/h, then fnc for nblk sectors from s
xfer:	mov	#FRHDR,r0
	call	cmd
	tst	r0
	beq	1$
	return
1$:	mov	@#rlmp,r1		; current cyl<<7 ! h<<6 ! s
	ash	#-7,r1
	bic	#177000,r1
	mov	c,r2			; difference
	sub	r1,r2
	mov	#1,r1			; marker
	tst	r2
	bmi	2$
	bis	#4,r1			; toward higher cylinders
	br	3$
2$:	neg	r2
3$:	ash	#7,r2
	bis	r2,r1
	tst	h
	beq	4$
	bis	#20,r1			; head select
4$:	mov	r1,@#rlda
	mov	#FSEEK,r0
	call	cmd
	tst	r0
	beq	5$
	return
5$:	mov	c,r1			; disk address
	ash	#7,r1
	tst	h
	beq	6$
	bis	#100,r1
6$:	bis	s,r1
	mov	r1,dareg
	mov	r1,@#rlda
	mov	buf,@#rlba
	mov	nblk,r1			; MP = -(words)
	ash	#7,r1
	neg	r1
	mov	r1,@#rlmp
	mov	fnc,r0
	call	cmd
	tst	r0
	beq	7$
	return
7$:	mov	nblk,r1			; BA advanced by the bytes moved
	ash	#8.,r1
	add	buf,r1
	cmp	@#rlba,r1
	beq	8$
	mov	#mba,r0
	return
8$:	mov	@#rlda,r1		; DA sector field advanced by nblk
	bic	#177700,r1
	mov	s,r2
	add	nblk,r2
	cmp	r1,r2
	beq	9$
	mov	#mda,r0
	return
9$:	clr	r0
	return
;
verify:	mov	s,-(sp)
	mov	buf,r2
	mov	nblk,r3
1$:	call	slot
	clr	salt
	cmp	c,#WCYL
	bhis	2$
	mov	SALTAB(r1),salt
2$:	cmp	(r2)+,c
	bne	9$
	mov	h,r1
	swab	r1
	bis	s,r1
	cmp	(r2)+,r1
	bne	8$
	call	key
	mov	c,r4
	bic	#177400,r4
	mov	#2,r0
3$:	mov	r0,r1
	swab	r1
	bis	r4,r1
	xor	r5,r1
	cmp	(r2)+,r1
	bne	8$
	inc	r0
	cmp	r0,#200
	blo	3$
	inc	s
	sob	r3,1$
	mov	(sp)+,s
	clr	r0
	return
9$:	mov	c,r1
8$:	mov	r2,r0
	tst	-(r0)
	mov	r0,badadr
	mov	r1,badexp
	mov	(r0),badgot
	mov	(sp)+,s
	mov	#mdat,r0
	return
;
gen:	mov	c,(r2)+
	mov	h,r1
	swab	r1
	bis	s,r1
	mov	r1,(r2)+
	call	key
	mov	c,r4
	bic	#177400,r4
	mov	#2,r0
1$:	mov	r0,r1
	swab	r1
	bis	r4,r1
	xor	r5,r1
	mov	r1,(r2)+
	inc	r0
	cmp	r0,#200
	blo	1$
	return
;
key:	mov	h,r5			; (h<<6 ! s) ^ 052525 ^ salt
	ash	#6,r5
	bis	s,r5
	mov	#052525,r1
	xor	r1,r5
	mov	salt,r1
	xor	r1,r5
	return
;
slot:	mov	c,r1			; byte offset of c/h/s in SALTAB (c < WCYL)
	mul	#80.,r1
	mov	r1,-(sp)
	mov	h,r1
	mul	#40.,r1
	add	(sp)+,r1
	add	s,r1
	asl	r1
	return
;
rand:	mov	seed,r0
	mul	#25173.,r0
	add	#13849.,r1
	mov	r1,seed
	bic	#100000,r1		; 15 bits: DIV by a small number must not overflow
	return
clkint:	inc	ticks
	rti
rlint:	inc	rlints
	rti
;
fail:	mov	r0,why
	inc	errs
	cmp	errs,#20.
	bhi	9$
	mov	#merrh,r0
	call	puts
	mov	why,r0
	call	puts
	mov	#miter,r0
	call	puts
	mov	iterh,r0
	call	puto
	mov	iterl,r0
	call	puto
	mov	#mchs,r0
	call	puts
	mov	c,r0
	call	puto
	mov	h,r0
	call	puto
	mov	s,r0
	call	puto
	mov	#mn,r0
	call	puts
	mov	nblk,r0
	call	puto
	mov	#mbuf,r0
	call	puts
	mov	buf,r0
	call	puto
	mov	#mmode,r0
	call	puts
	mov	fnc,r0
	call	puto
	mov	ie,r0
	call	puto
	call	crlf
	call	regs
	cmp	why,#mdat
	bne	9$
	mov	#mbad,r0
	call	puts
	mov	badadr,r0
	call	puto
	mov	#mexp,r0
	call	puts
	mov	badexp,r0
	call	puto
	mov	#mgot,r0
	call	puts
	mov	badgot,r0
	call	puto
	call	crlf
9$:	clr	ie
	call	gstat
	mov	rlints,expint
	jmp	next
;
regs:	mov	#mregs,r0
	call	puts
	mov	#rlcs,r1
	call	puto2
	mov	#rlba,r1
	call	puto2
	mov	#rlda,r1
	call	puto2
	mov	#rlmp,r1
	call	puto2
	mov	#mexpda,r0
	call	puts
	mov	dareg,r0
	call	puto
	mov	#mints,r0
	call	puts
	mov	rlints,r0
	call	puto
	mov	expint,r0
	call	puto
	jmp	crlf
;
trap4:	mov	#mtr4,r0
	br	trapx
trap10:	mov	#mtr10,r0
trapx:	call	puts
	mov	(sp),r0
	call	puto
	call	crlf
	halt
;
putc:	tstb	@#tps
	bpl	putc
	movb	r0,@#tpb
	return
puts:	mov	r0,r1
1$:	movb	(r1)+,r0
	beq	2$
	call	putc
	br	1$
2$:	return
crlf:	mov	#15,r0
	call	putc
	mov	#12,r0
	jmp	putc
puto:	mov	r0,-(sp)
	mov	#40,r0
	call	putc
	mov	(sp)+,r1
	mov	#6,r2
	clr	r0
	asl	r1
	rol	r0
	br	2$
1$:	clr	r0
	asl	r1
	rol	r0
	asl	r1
	rol	r0
	asl	r1
	rol	r0
2$:	add	#'0,r0
	mov	r1,-(sp)
	mov	r2,-(sp)
	call	putc
	mov	(sp)+,r2
	mov	(sp)+,r1
	sob	r2,1$
	return
puto2:	mov	(r1),r0
	jmp	puto
;
iterl:	.word	0
iterh:	.word	0
errs:	.word	0
ticks:	.word	0
rlints:	.word	0
expint:	.word	0
writes:	.word	0
seed:	.word	24680.
c:	.word	0
h:	.word	0
s:	.word	0
dareg:	.word	0
nblk:	.word	0
buf:	.word	0
fnc:	.word	0
ie:	.word	0
salt:	.word	0
nsalt:	.word	0
ncf:	.word	0
why:	.word	0
badadr:	.word	0
badexp:	.word	0
badgot:	.word	0
;
hello:	.byte	15,12
	.ascii	|rlex: RL11/RL02 whole-pack exerciser (seeks, interrupts, reads, writes)|
	.byte	15,12,0
mffull:	.asciz	/formatting the whole pack/<15><12>
mfquick:.asciz	/pack already formatted: rewriting cylinders 0-11/<15><12>
mcyl:	.asciz	/  cylinder/
mfdone:	.asciz	/format done/<15><12>
mfail:	.asciz	/*** format write failed/<15><12>
mstat:	.asciz	/xfers/
merr:	.asciz	/  errors/
mwr:	.asciz	/  writes/
mints:	.asciz	/  ints/
mtick:	.asciz	/  ticks/
merrh:	.asciz	/*** /
miter:	.byte	15,12
	.asciz	/    xfer/
mchs:	.asciz	/ c h s/
mn:	.asciz	/ n/
mbuf:	.asciz	/ buf/
mmode:	.asciz	/ fnc ie/
mregs:	.asciz	/    cs ba da mp/
mexpda:	.asciz	/  da sent/
mbad:	.asciz	/    at/
mexp:	.asciz	/ expected/
mgot:	.asciz	/ got/
mtmo:	.asciz	/timeout waiting for CRDY/
mitmo:	.asciz	/timeout waiting for the RL interrupt/
mint:	.asciz	/wrong number of RL interrupts/
merr1:	.asciz	/CS ERR set/
mba:	.asciz	/BA did not advance by the transfer/
mda:	.asciz	/DA sector not advanced by the transfer/
mgrd:	.asciz	/guard word overwritten/
mdat:	.asciz	/data word wrong/
mtr4:	.byte	15,12
	.asciz	/trap 4, pc/
mtr10:	.byte	15,12
	.asciz	/trap 10, pc/
	.even
	.end
