# raetro/quartus:mister with the select()/EINTR fix in libccl_thr.so, for running
# quartus_map --parallel under Rosetta on Apple silicon. See notes/quartus-apple-silicon.md.
#
#   container build --arch amd64 -t raetro/quartus:mister-eintr -f tools/quartus/Containerfile tools/quartus
#   (docker build --platform linux/amd64 ... works the same way)
FROM raetro/quartus:mister
COPY patch_libccl_thr_eintr.py /tmp/patch_libccl_thr_eintr.py
RUN python3 /tmp/patch_libccl_thr_eintr.py && rm /tmp/patch_libccl_thr_eintr.py
