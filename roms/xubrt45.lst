     269 002044 000167  177122                   jmp    t45loop                ; FIXME, come up with something slightly more sensible
     270                                ;
     271                                ; pcsrsrv - service commands issued through the pcsr registers
     272                                ;
     273                                pcsrsrv:
     274 002050 013701  174510                   mov    @#174510,r1            ; #20 bit flags if a new command is in the register
     275                                ;
     276                                ; check if the reset bit is set in pcsr0
     277                                ;
     278 002054 032701  000040                   bit    #40,r1                 ; rset bit set?
     279 002060 001404                           beq    psv100                 ; no
     280 002062 105037  174510                   clrb   @#174510               ; reset rset bit - only a byte write to the low byte does this :-)
     281 002066 000167  176706                   jmp    t45                    ; not a reboot, but fairly close
     282                                ;
     283                                ; check if the #20 bit is set - this is a bit in an unused bit field of the original deuna, that xu uses to detect that pcsr0 was written into
     284                                ;
     285                                psv100:
     286 002072 032701  000020                   bit    #20,r1                 ; cmd written bit set?
     287 002076 001002                           bne    psv110                 ; yes
     288 002100 000167  000026                   jmp    psv900                 ; no
     289                                psv110:
     290 002104 105037  174510                   clrb   @#174510               ; reset flag bit - only a byte write to the low byte does this :-)
     291 002110 042701  177760                   bic    #177760,r1             ; mask off p0cmd bit field from pcsr0
     292 002114 010167  013110                   mov    r1,p0cmd               ; store it
     293 002120 006301                           asl    r1
     294 002122 062701  003106                   add    #ptab,r1               ; add code to base of jump table
     295 002126 011101                           mov    (r1),r1
     296 002130 004711                           jsr    pc,(r1)                ; call the service routine
     297                                psv900:
     298 002132 000207                           rts pc                        ; done
