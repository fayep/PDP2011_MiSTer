     147                                ; main service loop - receive packets if we're running
     148                                ;
     149                                10$:
     150 001172 005067  015262                   clr    dogtick                ; need to do this every 10 seconds, or watchdog will cause reboot
     151 001176 005267  015244                   inc    hbcnt                  ; DBG heartbeat -- low-rate proof the main loop is still cycling,
     152 001202 005767  015240                   tst    hbcnt                  ; not silently stuck (console alone can't tell idle from hung).
     153 001206 001012                           bne    11$                    ; prints only once every 65536 passes -- cheap, won't flood.
