     146                                ;
     147                                ; main service loop - receive packets if we're running
     148                                ;
     149                                10$:
     150 001172 005067  015406                   clr    dogtick                ; need to do this every 10 seconds, or watchdog will cause reboot
     151                                         ; DBG heartbeat -- disabled 2026-08-29. Already proved conclusively
     152                                         ; (many hours of real logs) that the main loop never halts; kept
     153                                         ; hbcnt itself counting (harmless, may be useful again later) but
     154                                         ; stopped printing so it no longer drowns out the p0cmd/pcsr0
     155                                         ; dispatch trace, which is the actually-useful signal right now.
     156 001176 005267  015366                   inc    hbcnt
     157                                11$:
     158 001202 005767  015366                   tst    running                ; in running state?
     159 001206 001411                           beq    20$                    ; no - jump
     160 001210 004767  007552                   jsr    pc,pktin               ; process input packets
     161 001214 005767  015516                   tst    recvdw                 ; did we do any work receiving?
     162 001220 001404                           beq    20$                    ; no - jump
     163 001222 052737  020000  174510           bis    #20000,@#174510        ; set rxi
     164 001230 000760                           br     10$                    ; see if there is another frame - FIXME, check if there is an owned buffer first?
     165                                20$:
     166                                ;
     167                                ; check if the chip is ok - reading the eidled register; this serves no particular purpose other than checking if we're still talking to the chip
     168                                ; if comms was lost - including removing the chip and reconnecting it - reset it and set it up so it will work again.
     169                                ;
     170 001232 005067  012572                   clr    deidled
