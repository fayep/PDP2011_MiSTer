     192                                         ; ENC424J600 stores the MAC fully byte-reversed across MAADR1H
     193                                         ; (canonical byte 1/OUI0) .. MAADR3L (canonical byte 6) --
     194                                         ; datasheet DS39935C Table 3-7. wlaa/dlaa conversion must be a
     195                                         ; full 6-byte reversal to match, not a partial swap.
     196 001412 116767  012571  012570           movb   wlaa+7,dlaa+0
     197 001420 116767  012562  012563           movb   wlaa+6,dlaa+1
     198 001426 116767  012553  012556           movb   wlaa+5,dlaa+2
     199 001434 116767  012544  012551           movb   wlaa+4,dlaa+3
     200 001442 116767  012535  012544           movb   wlaa+3,dlaa+4
