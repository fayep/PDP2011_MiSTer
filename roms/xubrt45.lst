     208                                xrxreset:
     209 001454 005067  013542                   clr    rxdis                  ; throttle latch is meaningless across a chip re-init
     210                                ;         clr    @#174512               ; pcsr1 - state=reset  FIXME, this kills the software on bsd
     211 001460 004767  007374                   jsr    pc,initenc
     212 001464 004767  013432                   jsr    pc,waitabit
     213 001470 105767  011136                   tstb   wlaa+2                 ; check to see if the mac address was set
     214 001474 001017                           bne    22$
     215 001476 105767  011131                   tstb   wlaa+3
     216 001502 001014                           bne    22$
     217 001504 105767  011124                   tstb   wlaa+4
     218 001510 001011                           bne    22$
     219 001512 105767  011117                   tstb   wlaa+5
     220 001516 001006                           bne    22$
     221 001520 105767  011112                   tstb   wlaa+6
     222 001524 001003                           bne    22$
     223 001526 105767  011105                   tstb   wlaa+7
     224 001532 001436                           beq    23$
     225                                22$:
     226                                         xascil <restoring laa>        ; restore the mac address to what was set
       1 001534 004767  012544                   jsr    pc,xasciz
       2 001540    162     145     163           .ascii /restoring laa/
         001543    164     157     162  
         001546    151     156     147  
         001551    040     154     141  
         001554    141                  
       3 001555    015     012     000           .asciz <15><12>
       4                                         .even
     227                                         ; ENC424J600 stores the MAC fully byte-reversed across MAADR1H
     228                                         ; (canonical byte 1/OUI0) .. MAADR3L (canonical byte 6) --
     229                                         ; datasheet DS39935C Table 3-7. wlaa/dlaa conversion must be a
     230                                         ; full 6-byte reversal to match, not a partial swap.
     231 001560 116767  011053  011052           movb   wlaa+7,dlaa+0
     232 001566 116767  011044  011045           movb   wlaa+6,dlaa+1
     233 001574 116767  011035  011040           movb   wlaa+5,dlaa+2
     234 001602 116767  011026  011033           movb   wlaa+4,dlaa+3
     235 001610 116767  011017  011026           movb   wlaa+3,dlaa+4
     236 001616 116767  011010  011021           movb   wlaa+2,dlaa+5
     237 001624 004767  010716                   jsr    pc,setlaa
     238                                23$:
     239 001630 005767  013400                   tst    modebits
     240 001634 001417                           beq    24$
     241                                         xascil <restoring modebits>   ; restore the mode bits to what was set
       1 001636 004767  012442                   jsr    pc,xasciz
       2 001642    162     145     163           .ascii /restoring modebits/
         001645    164     157     162  
         001650    151     156     147  
         001653    040     155     157  
         001656    144     145     142  
         001661    151     164     163  
       3 001664    015     012     000           .asciz <15><12>
       4 001667    000                           .even
