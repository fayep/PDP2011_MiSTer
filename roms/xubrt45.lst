     235                                ; pcsrsrv - service commands issued through the pcsr registers
     236                                ;
     237                                pcsrsrv:
     238 001702 013701  174510                   mov    @#174510,r1            ; #20 bit flags if a new command is in the register
     239                                ;
     240                                ; check if the reset bit is set in pcsr0
