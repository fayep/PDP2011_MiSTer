     190                                         ; ENC424J600 stores the MAC fully byte-reversed across MAADR1H
     191                                         ; (canonical byte 1/OUI0) .. MAADR3L (canonical byte 6) --
     192                                         ; datasheet DS39935C Table 3-7. wlaa/dlaa conversion must be a
     193                                         ; full 6-byte reversal to match, not a partial swap.
     194 001444 116767  012415  012414           movb   wlaa+7,dlaa+0
     195 001452 116767  012406  012407           movb   wlaa+6,dlaa+1
     196 001460 116767  012377  012402           movb   wlaa+5,dlaa+2
     197 001466 116767  012370  012375           movb   wlaa+4,dlaa+3
     198 001474 116767  012361  012370           movb   wlaa+3,dlaa+4
     199 001502 116767  012352  012363           movb   wlaa+2,dlaa+5
