     108                                         jsr    pc,xbhx
     109                                         .word  w
     110                                         .word  l
     111                                         .endm
     112                                ;
     113                                         .macro xwhx w,l
     114                                         jsr    pc,xwhx
     115                                         .word  w
     116                                         .word  l
     117                                         .endm
