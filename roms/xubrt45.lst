     134 001132 004767  007722                   jsr    pc,initenc             ; contact the encx24j600 and reset it
     135                                ;
     136 001136 005037  177776                   clr    @#177776               ; clear psw - this enables the watchdog interrupts
     137                                ;
     138 001142 012737  004000  174510           mov    #4000,@#174510         ; pcsr0 - dni
     139 001150 005700                           tst    r0
     140 001152 001403                           beq    5$
     141 001154 005037  174512                   clr    @#174512               ; pcsr1 - state=reset
     142 001160 000404                           br     10$
     143                                5$:
     144 001162 012737  000002  174512           mov    #2,@#174512            ; pcsr1 - state=ready
     145 001170 000400                           br     10$
     146                                ;
     147                                ; main service loop - receive packets if we're running
     148                                ;
     149                                10$:
     150                                t45loop:
     151 001172 005067  014034                   clr    dogtick                ; need to do this every 10 seconds, or watchdog will cause reboot
     152                                11$:
     153 001176 005767  014016                   tst    running                ; in running state?
     154 001202 001446                           beq    12$                    ; no - jump
     155                                         ; queue/flow control: our RX ring only has 6 real slots. If the
     156                                         ; chip-side backlog (PKTCNT via ESTAT) is bigger than that, clear
     157                                         ; RXEN so the chip stops accepting new frames while we drain what
     158                                         ; it already has -- otherwise continuous real LAN traffic keeps
     159                                         ; recvdw set forever and we never catch up. Re-enabled below once
     160                                         ; the backlog is gone.
     161                                         xubl   restat,20,destat,20    ; peek chip-side backlog before draining
       1 001204 004767  011436                   jsr    pc,xubl
       2 001210 012442                           .word  restat                                ; restat  : from address - write to spi
       3 001212 000020                           .word  20                               ; 20 : from length in bits, multiple of 8 (lower three bits are ignored)
       4 001214 012444                           .word  destat                                ; destat  : to address - read from spi
       5 001216 000020                           .word  20                               ; 20 : to length in bits, multiple of 8 (lower three bits are ignored)
     162 001220 116767  011220  014360           movb   destat,pktcnt
     163 001226 005767  014354                   tst    pktcnt                 ; nothing queued at all?
     164 001232 001432                           beq    12$                    ; skip pktin entirely (avoids a second,
     165                                                                        ; redundant restat inside pktin itself)
     166                                                                        ; -- 12$ still checks/clears rxdis below,
     167                                                                        ; so a throttle from an earlier pass gets
     168                                                                        ; re-enabled correctly even on this path.
     169 001234 026727  014346  000006           cmp    pktcnt,#6              ; more queued than our ring can absorb this pass?
     170                                         ; NOTE: CMP src,dst computes src-dst; BLOS branches on src<=dst.
     171                                         ; Must be pktcnt (src) vs #6 (dst) so BLOS means pktcnt<=6 --
     172                                         ; the reversed order ("cmp #6,pktcnt") inverted the throttle.
     173 001242 101414                           blos   13$
     174 001244 005767  013752                   tst    rxdis
     175 001250 001011                           bne    13$                    ; already throttled
     176                                         xubl   cecon1,40              ; clear RXEN -- stop chip accepting new frames
       1 001252 004767  011370                   jsr    pc,xubl
       2 001256 012502                           .word  cecon1                                ; cecon1  : from address - write to spi
       3 001260 000040                           .word  40                               ; 40 : from length in bits, multiple of 8 (lower three bits are ignored)
       4 001262 000000                           .word                                  ;   : to address - read from spi
       5 001264 000000                           .word                                 ;  : to length in bits, multiple of 8 (lower three bits are ignored)
     177 001266 012767  000001  013726           mov    #1,rxdis
     178                                13$:
     179 001274 004767  006210                   jsr    pc,pktin               ; process input packets
     180 001300 005767  014060                   tst    recvdw                 ; did we do any work receiving?
     181 001304 001405                           beq    12$                    ; no - jump
     182 001306 052737  020000  174510           bis    #20000,@#174510        ; set rxi
     183 001314 000167  177652                   jmp    t45loop                ; see if there is another frame
     184                                12$:
     185 001320 005767  013676                   tst    rxdis                  ; were we throttling reception?
     186 001324 001421                           beq    20$
     187                                         ; Only re-enable RXEN when the chip backlog is actually gone.
     188                                         ; pktin bails with recvdw=0 when the 6-slot host ring is full
     189                                         ; (telnet/TCP) even though PKTCNT is still high -- re-enabling
     190                                         ; then flaps RXEN every loop pass.
     191                                         xubl   restat,20,destat,20
       1 001326 004767  011314                   jsr    pc,xubl
       2 001332 012442                           .word  restat                                ; restat  : from address - write to spi
       3 001334 000020                           .word  20                               ; 20 : from length in bits, multiple of 8 (lower three bits are ignored)
       4 001336 012444                           .word  destat                                ; destat  : to address - read from spi
       5 001340 000020                           .word  20                               ; 20 : to length in bits, multiple of 8 (lower three bits are ignored)
     192 001342 105767  011076                   tstb   destat
     193 001346 001010                           bne    20$                    ; still queued -- keep RXEN clear
     194                                         xubl   xecon1,40              ; re-enable RXEN -- backlog drained
       1 001350 004767  011272                   jsr    pc,xubl
       2 001354 012472                           .word  xecon1                                ; xecon1  : from address - write to spi
       3 001356 000040                           .word  40                               ; 40 : from length in bits, multiple of 8 (lower three bits are ignored)
       4 001360 000000                           .word                                  ;   : to address - read from spi
       5 001362 000000                           .word                                 ;  : to length in bits, multiple of 8 (lower three bits are ignored)
     195 001364 005067  013632                   clr    rxdis
     196                                20$:
     197                                ;
     198                                ; check if the chip is ok - reading the eidled register; this serves no particular purpose other than checking if we're still talking to the chip
     199                                ; if comms was lost - including removing the chip and reconnecting it - reset it and set it up so it will work again.
     200                                ;
     201 001370 005067  011054                   clr    deidled
     202                                         xubl   reidled,20,deidled,20
       1 001374 004767  011246                   jsr    pc,xubl
       2 001400 012446                           .word  reidled                                ; reidled  : from address - write to spi
       3 001402 000020                           .word  20                               ; 20 : from length in bits, multiple of 8 (lower three bits are ignored)
       4 001404 012450                           .word  deidled                                ; deidled  : to address - read from spi
       5 001406 000020                           .word  20                               ; 20 : to length in bits, multiple of 8 (lower three bits are ignored)
     203 001410 005767  011034                   tst    deidled
     204 001414 001402                           beq    21$
     205 001416 000167  000300                   jmp    t45poll
     206                                21$:
