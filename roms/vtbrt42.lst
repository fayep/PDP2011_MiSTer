    1315                                ;
    1316                                ; adjdwh - adjust cursor pos and line content on changing a line to double height/width
    1317                                ;
    1318                                adjdwh:
    1319 005144 026727  173210  000050           cmp curc,#40.            ; is the cursor past column 40 decimal?
    1320 005152 101403                           blos 10$                 ; no
    1321 005154 012767  000050  173176           mov #40.,curc            ; set it at 40
    1322                                10$:
    1323 005162 016700  173166                   mov curr,r0              ; get current row
    1324 005166 010001                           mov r0,r1                ; copy
    1325 005170 005300                           dec r0                   ; correct for offset
    1326 005172 006300                           asl r0                   ; make word index
    1327 005174 016000  016570                   mov ltab(r0),r0          ; pick up the offset
    1328 005200 062700  000120                   add #80.,r0              ; add half the screen width - two bytes per pos, hence 80.
    1329 005204 006301                           asl r1                   ; word index of current line+1 - the +1 is implicit
    1330 005206 016101  016570                   mov ltab(r1),r1          ; pick up the offset
    1331                                20$:
    1332 005212 012720  000040                   mov #40,(r0)+            ; erase here
    1333 005216 020001                           cmp r0,r1                ; at the end yet?
    1334 005220 103774                           blo 20$                  ; branch if not
    1335 005222 000207                           rts pc                   ; done
