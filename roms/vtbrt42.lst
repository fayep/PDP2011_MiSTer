    1278 005050 112760  000005  140040           movb #5,vgadwh(r0)       ; set double height bit and double width bit
    1279 005056 004767  000062                   jsr pc,adjdwh            ; adjust cursor and clear 2nd half of line
    1280 005062 000207                           rts pc
    1281                                ;
    1282                                ; -------------------------------------------------------------------
