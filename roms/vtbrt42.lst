    1259                                ; decaln - fill buffer with E
    1260                                ;
    1261                                decaln:
    1262 005014 004767  000204                   jsr pc,clrdwh            ; clear double height/double width
    1263 005020 012700  100000                   mov #100000,r0           ; setup r0 as start address
    1264 005024 012701  107400                   mov #107400,r1           ; setup r1 as end condition
    1265                                80$:
