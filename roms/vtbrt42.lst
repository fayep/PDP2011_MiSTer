     256                                ;
     257                                ; start of code
     258                                ;
     259                                ; -------------------------------------------------------------------
     260                                ;
     261 001000                                  .=lc+1000
     262                                t42:
     263 001000 012737  000340  177776           mov #340,@#177776        ; set psw prio to 7 - block interrupts
     264 001006 012706  001000                   mov #1000,sp
     265                                ;
     266                                ; setup receive buffers
     267                                ;
     268 001012 005067  177326                   clr rcvcons              ; consume equal produce means buffer empty
     269 001016 005067  177324                   clr rcvprod              ; receive is what we receive on our slu port
     270 001022 005067  177312                   clr rcvbfc               ; clear buffer count
     271 001026 105067  177310                   clrb xoff                ; clear xon/xoff state
     272 001032 105067  177305                   clrb xoffm               ; clear xon/xoff manual state
     273 001036 005067  177306                   clr ps2cons              ; first we consume, then we produce
     274 001042 005067  177304                   clr ps2prod              ; xmit is what we received from the ps2 port
     275                                ;
     276                                ; setup interrupt vectors
     277                                ;
     278 001046 012737  014752  000060           mov #ivecrcv,@#60        ; slu receive vector
     279 001054 012737  000340  000062           mov #340,@#62            ; 340 - isr runs disabled
     280 001062 012737  015114  000064           mov #ivecxmt,@#64        ; slu xmit vector (not used)
     281 001070 012737  000340  000066           mov #340,@#66            ; 340 - isr runs disabled
     282 001076 012737  015116  000070           mov #ivecps2,@#70        ; ps2 receive vector
     283 001104 012737  000340  000072           mov #340,@#72            ; 340 - isr runs disabled
     284 001112 012737  000100  177560           mov #100,@#rcsr          ; set interrupt enable in slu
     285 001120 012737  000100  150000           mov #100,@#150000        ; set interrupt enable in ps2
     286 001126 012737  000000  177776           mov #0,@#177776          ; allow interrupts on all levels
     287                                ;
     288                                ; setup frame buffer etc
     289                                ;
     290 001134 005067  177446                   clr pstate
     291 001140 004767  004060                   jsr pc,clrdwh            ; clear double height/double width
     292 001144 012703  100000                   mov #100000,r3           ; start of buffer
     293                                1$:
     294 001150 012723  000040                   mov #40,(r3)+            ; fill the buffer with spaces
     295 001154 020327  107400                   cmp r3,#107400           ; at the end yet?
     296 001160 001373                           bne 1$                   ; branch if no
     297                                
     298 001162 012702  015210                   mov #hello,r2            ; set up for hello world
     299 001166 012703  100000                   mov #100000,r3           ; at the start of the screen
     300                                2$:
     301 001172 112200                           movb (r2)+,r0            ; load char
     302 001174 010023                           mov r0,(r3)+             ; write in buffer
     303 001176 001375                           bne 2$                   ; end of the string done yet? branch if not
     304 001200 012743  000040                   mov #40,-(r3)            ; erase error char caused by zero terminated string
     305                                
     306 001204 022737  000151  140012           cmp #105.,@#vgavtt       ; check for vt type
     307 001212 001003                           bne 3$
     308 001214 012737  000065  100044           mov #65,@#100044         ; move type into banner
     309                                3$:
     310                                ;
     311                                ; init more
     312                                ;
     313 001222 105067  177276                   clrb ps2up               ; clear up/break status
     314 001226 105067  177273                   clrb ps2ex               ; clear extended status
     315 001232 105067  177270                   clrb ps2lc               ; clear left control
     316 001236 105067  177265                   clrb ps2rc               ; clear right control
     317 001242 105067  177262                   clrb ps2ls               ; clear left shift
     318 001246 105067  177257                   clrb ps2rs               ; clear right shift
     319 001252 105067  177254                   clrb ps2cl               ; clear caps
     320 001256 004767  012324                   jsr pc,gbclr             ; clear graph memories
     321 001262 012767  000003  177064           mov #3,curr              ; init cursor position, should probably be 1,1 at some point but the hello world is there
     322 001270 012767  000001  177062           mov #1,curc              ; init column
     323 001276 012767  000001  177052           mov #1,scurr             ; init saved row
     324 001304 012767  000001  177050           mov #1,scurc             ; init saved col
     325 001312 112767  000102  177052           movb #chrasc,chrset      ; default char set is ascii
     326 001320 112767  000102  177042           movb #chrasc,g0set       ; set g0 set to ascii default too
     327 001326 112767  000102  177035           movb #chrasc,g1set       ; set g1 set to ascii default too
     328 001334 112767  000102  177031           movb #chrasc,schrst      ; init saved char set
     329 001342 105067  177026                   clrb shftst              ; G0 in use
     330 001346 105067  177023                   clrb sshfst              ; saved: G0 in use
     331 001352 012767  000001  177016           mov #dtmarg,tmarg        ; default scroll window from line 1
     332 001360 012767  000030  177012           mov #dbmarg,bmarg        ; to 24
     333 001366 012767  000030  177006           mov #dwsize,wsize        ; init wsize
     334 001374 105067  176766                   clrb atth                ; init attribute
     335 001400 105067  176763                   clrb satth               ; init saved attribute
     336 001404 105067  177144                   clrb decom               ; clear origin mode
     337 001410 112767  000001  177132           movb #1,decawm           ; set awm, seems the most reasonable default
     338 001416 105067  177125                   clrb ansins              ; clear insert mode
     339 001422 105067  177120                   clrb anslnm              ; clear new line mode
     340 001426 105067  177121                   clrb deccolm             ; clear 132-column mode (not implemented for now)
     341 001432 105067  177113                   clrb decckm              ; clear cursor key mode (not implemented for now)
     342 001436 105067  176722                   clrb lcf                 ; clear last column flag
     343 001442 105067  176717                   clrb slcf                ; clear saved last column flag
     344 001446 105067  177063                   clrb vt105g              ; clear graphics mode flag
     345 001452 105067  177060                   clrb grshl1              ; clear shade load flag
     346 001456 105067  177051                   clrb vt52                ; clear vt52 mode flag
     347 001462 105067  177046                   clrb vt52yl              ; clear vt52 direct cursor address temp storage
     348 001466 105067  177060                   clrb deckpam             ; clear keypad application mode
     349 001472 005037  140002                   clr @#vgacr              ; set all control register flags off
     350 001476 005037  140004                   clr @#vgash0             ; clear shade line 0
     351 001502 005037  140006                   clr @#vgash1             ; clear shade line 1
     352 001506 005037  140014                   clr @#vgaact             ; clear activity counter
     353                                ;
     354                                ; mainline code
     355                                ;
     356                                4$:
     357 001512 004767  007374                   jsr pc,fba               ; get buffer address of current pos
     358 001516 010037  140000                   mov r0,@#vgacur          ; write cursor position into control register
     359                                ;
     360                                ; check keyboard for input
     361                                ;
     362 001522 004767  012244                   jsr pc,ps2getc           ; try to read keyboard
     363 001526 005700                           tst r0                   ; anything?
     364 001530 001420                           beq 6$                   ; branch if not
     365 001532 105237  140014                   incb @#vgaacl            ; show activity
     366 001536 004767  012536                   jsr pc,ps2xlt            ; try to translate scan code into character or code for routine
     367 001542 005700                           tst r0                   ; anything?
     368 001544 001412                           beq 6$                   ; branch if not
     369 001546 120127  000340                   cmpb r1,#kcminc          ; did ps2xlt return a character or a function code?
     370 001552 103403                           blo 5$                   ; branch if character
     371 001554 004767  001476                   jsr pc,kcproc            ; process key codes
     372 001560 000754                           br 4$                    ; done
     373                                5$:
     374 001562 010100                           mov r1,r0                ; regular char, move it to r0
     375 001564 004767  013310                   jsr pc,xmit              ; and xmit to the host
     376 001570 000750                           br 4$                    ; done
     377                                ;
     378                                ; check serial port for input
     379                                ;
     380                                6$:
     381 001572 004767  012042                   jsr pc,rcvgetc           ; try to read a char
     382 001576 005700                           tst r0                   ; did we get one?
     383 001600 001744                           beq 4$                   ; r0 zero means no
     384 001602 105237  140015                   incb @#vgaach            ; show activity
     385 001606 042701  177600                   bic #177600,r1           ; make sure only 7 bits left
     386 001612 004767  010252                   jsr pc,cntrl             ; process control character
     387 001616 005701                           tst r1                   ; did cntrl clear r1?
     388 001620 001734                           beq 4$                   ; yes - it dealt with the character
     389                                7$:
     390 001622 116100  015302                   movb ptrans(r1),r0       ; check state transition table
     391 001626 005700                           tst r0                   ; zero means not
     392 001630 001402                           beq 8$
     393 001632 010067  176750                   mov r0,pstate            ; load new state
     394                                8$:
     395 001636 016700  176744                   mov pstate,r0            ; load parser state
     396 001642 042700  177761                   bic #177761,r0           ; make sure even and in range
     397 001646 062700  015242                   add #ptab,r0             ; add start of table
     398 001652 011000                           mov (r0),r0              ; load address of parser routine from table
     399 001654 004710                           jsr pc,(r0)              ; go there
     400                                
     401 001656 000715                           br 4$
     402                                ;
     403                                ; -------------------------------------------------------------------
     404                                ;
     405                                ; gparse - parse graphics instructions
     406                                ;
     407                                gparse:
     408 001660 120127  000100                   cmpb r1,#100             ; @ - lowest value graphics mode designator
     409 001664 103415                           blo 10$                  ; lower?
     410 001666 120127  000114                   cmpb r1,#114             ; L - highest value
     411 001672 101012                           bhi 10$                  ; higher?
     412 001674 162701  000100                   sub #100,r1              ; base from 0
     413 001700 006301                           asl r1                   ; make word index
     414 001702 016101  002060                   mov gpt(r1),r1           ; load address
     415 001706 010167  176626                   mov r1,gpload            ; set routine
     416 001712 005067  176624                   clr gpch1
     417 001716 000456                           br 90$
     418                                10$:
     419 001720 120127  000040                   cmpb r1,#40              ; space - lowest value graphics value
     420 001724 103450                           blo 80$                  ; lower?
     421 001726 120127  000077                   cmpb r1,#77              ; ? - highest value
     422 001732 101045                           bhi 80$                  ; higher?
     423 001734 005767  176602                   tst gpch1                ; first char already set?
     424 001740 001015                           bne 20$                  ; branch if yes
     425 001742 010167  176574                   mov r1,gpch1             ; set it now
