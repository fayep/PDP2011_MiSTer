     326 173742    015     012          bootmt:  .ascii <15><12>
     327 173744    155     164     000           .asciz /mt/
     328 173747    015     012          bootrk:  .ascii <15><12>
     329 173751    162     153     000           .asciz /rk/
     330 173754    015     012          bootrl:  .ascii <15><12>
     331 173756    162     154     000           .asciz /rl/
     332 173761    015     012          bootrp:  .ascii <15><12>
     333 173763    162     160     000           .asciz /rp/
     334 173766    015     012          nodev:   .ascii <15><12>
     335 173770    077     000                   .asciz /?/
     336                                         .even
     337                                
     338                                   .end
