     334 173750    015     012          bootmt:  .ascii <15><12>
     335 173752    155     164     000           .asciz /mt/
     336 173755    015     012          bootrk:  .ascii <15><12>
     337 173757    162     153     000           .asciz /rk/
     338 173762    015     012          bootrl:  .ascii <15><12>
     339 173764    162     154     000           .asciz /rl/
     340 173767    015     012          bootrp:  .ascii <15><12>
     341 173771    162     160     000           .asciz /rp/
     342 173774    015     012          nodev:   .ascii <15><12>
     343 173776    077     000                   .asciz /?/
     344                                         .even
     345                                
     346                                   .end
