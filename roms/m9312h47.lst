     329 173746    015     012          bootmt:  .ascii <15><12>
     330 173750    155     164     000           .asciz /mt/
     331 173753    015     012          bootrk:  .ascii <15><12>
     332 173755    162     153     000           .asciz /rk/
     333 173760    015     012          bootrl:  .ascii <15><12>
     334 173762    162     154     000           .asciz /rl/
     335 173765    015     012          bootrp:  .ascii <15><12>
     336 173767    162     160     000           .asciz /rp/
     337 173772    015     012          nodev:   .ascii <15><12>
     338 173774    077     000                   .asciz /?/
     339                                         .even
     340                                
     341                                   .end
