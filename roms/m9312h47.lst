     331 173746    015     012          bootmt:  .ascii <15><12>
     332 173750    155     164     000           .asciz /mt/
     333 173753    015     012          bootrk:  .ascii <15><12>
     334 173755    162     153     000           .asciz /rk/
     335 173760    015     012          bootrl:  .ascii <15><12>
     336 173762    162     154     000           .asciz /rl/
     337 173765    015     012          bootrp:  .ascii <15><12>
     338 173767    162     160     000           .asciz /rp/
     339 173772    015     012          nodev:   .ascii <15><12>
     340 173774    077     000                   .asciz /?/
     341                                         .even
     342                                
     343                                   .end
