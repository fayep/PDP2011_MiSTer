     279 173646    142     157     157           .ascii /boot from rk:/
         173651    164     040     146  
         173654    162     157     155  
         173657    040     162     153  
         173662    072                  
     280 173663    015     012     000           .asciz <15><12>
     281 173666    015     012          bootrl:  .ascii <15><12>
     282 173670    142     157     157           .ascii /boot from rl:/
         173673    164     040     146  
         173676    162     157     155  
         173701    040     162     154  
         173704    072                  
     283 173705    015     012     000           .asciz <15><12>
     284 173710    015     012          bootrp:  .ascii <15><12>
     285 173712    142     157     157           .ascii /boot from rp:/
         173715    164     040     146  
         173720    162     157     155  
         173723    040     162     160  
         173726    072                  
     286 173727    015     012     000           .asciz <15><12>
     287 173732    015     012          nodev:   .ascii <15><12>
     288 173734    142     157     157           .ascii /boot: no dev/
         173737    164     072     040  
         173742    156     157     040  
         173745    144     145     166  
     289 173750    015     012     000           .asciz <15><12>
     290 173753    000                           .even
