     329 173736    015     012          bootmt:  .ascii <15><12>
     330 173740    155     164     000           .asciz /mt/
     331 173743    015     012          bootrk:  .ascii <15><12>
     332 173745    162     153     000           .asciz /rk/
     333 173750    015     012          bootrl:  .ascii <15><12>
     334 173752    162     154     000           .asciz /rl/
     335 173755    015     012          bootrp:  .ascii <15><12>
     336 173757    162     160     000           .asciz /rp/
     337 173762    015     012          nodev:   .ascii <15><12>
     338 173764    077     000                   .asciz /?/
     339                                         .even
     340                                
     341                                   .end
