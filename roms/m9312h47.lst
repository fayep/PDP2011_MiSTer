       1                                         .title   M9312 boot roms
       2                                ;
       3                                ;
       4                                ; boot code taken from http://ak6dn.dyndns.org/PDP-11/M9312/ and modified to work with m9312l47.mac
       5                                ; which does not include diagnostics, does not use the rom code letters.
       6                                ;
       7                                ; $Revision$
       8                                
       9 000001                         bit0     =000001              ; plain old bit definitions
      10 000002                         bit1     =000002              ;
      11 000004                         bit2     =000004              ;
      12 000010                         bit3     =000010              ;
      13 000020                         bit4     =000020              ;
      14 000040                         bit5     =000040              ;
      15 000100                         bit6     =000100              ;
      16 000200                         bit7     =000200              ;
      17 000400                         bit8     =000400              ;
      18 001000                         bit9     =001000              ;
      19 002000                         bit10    =002000              ;
      20 004000                         bit11    =004000              ;
      21 010000                         bit12    =010000              ;
      22 020000                         bit13    =020000              ;
      23 040000                         bit14    =040000              ;
      24 100000                         bit15    =100000              ;
      25                                
      26 000040                         BL       =040                 ; ascii SPACE
      27 000015                         CR       =015                 ; ascii CR
      28 000012                         LF       =012                 ; ascii LF
      29 000400                         U        =bit8                ; upperbyte multiplier
      30 000001                         L        =bit0                ; lowerbyte multiplier
      31                                
      32                                         .asect
      33 173000                                  .=173000
      34                                ;
      35                                ;
      36                                ;
      37 173000 000137  173014                   jmp   @#boot         ; 173000
      38 173004 000137  173574                   jmp   @#prtoct       ; 173004
      39                                bprtascz:
      40 173010 000137  173550                   jmp   @#prtascz      ; 173010
      41                                ;
      42                                ; boot: boot from first controller that exists in the system out of rk,rl,rh
      43                                ;
      44                                boot:
      45 173014 012706  001000                   mov   #1000,sp
      46 173020 005037  000006                   clr   @#6
      47 173024 012737  173072  000004           mov   #nork,@#4
      48 173032 005737  177400                   tst   @#177400       ; NXM probe -- traps to nork if RK isn't present at all
      49 173036 032737  000200  177400           bit   #200,@#177400  ; RKDS bit 07 (DRY) -- present but no pack loaded?
      50 173044 001412                           beq   nork           ; not ready -- fall through, same as not present
      51 173046 012702  173644                   mov   #bootrk,r2
      52 173052 010701                           mov   pc,r1
      53 173054 000755                           br    bprtascz
      54 173056 005037  000004                   clr   @#4
      55 173062 005037  000006                   clr   @#6
      56 173066 005000                           clr   r0
      57 173070 000535                           br    rkgo
      58                                ;
      59                                nork:
      60 173072 012706  001000                   mov   #1000,sp
      61 173076 005037  000006                   clr   @#6
      62 173102 012737  173140  000004           mov   #norl,@#4
      63 173110 005737  174400                   tst   @#174400
      64 173114 012702  173666                   mov   #bootrl,r2
      65 173120 010701                           mov   pc,r1
      66 173122 000732                           br    bprtascz
      67 173124 005037  000004                   clr   @#4
      68 173130 005037  000006                   clr   @#6
      69 173134 005000                           clr   r0
      70 173136 000430                           br    rlgo
      71                                ;
      72                                norl:
      73 173140 012706  001000                   mov   #1000,sp
      74 173144 005037  000006                   clr   @#6
      75 173150 012737  173206  000004           mov   #norp,@#4
      76 173156 005737  176700                   tst   @#176700
      77 173162 012702  173710                   mov   #bootrp,r2
      78 173166 010701                           mov   pc,r1
      79 173170 000707                           br    bprtascz
      80 173172 005037  000004                   clr   @#4
      81 173176 005037  000006                   clr   @#6
      82 173202 005000                           clr   r0
      83 173204 000522                           br    rpgo
      84                                ;
      85                                norp:
      86 173206 012702  173732                   mov   #nodev,r2
      87 173212 010701                           mov   pc,r1
      88 173214 000675                           br    bprtascz
      89 173216 000000                           halt
      90                                
      91                                ; --------------------------------------------------
      92                                ; rl
      93                                ; --------------------------------------------------
      94                                
      95 174400                         rlcsr     =174400             ; std RL11 csrbase
      96                                
      97 000000                         rlcs      =+0                 ; control/status
      98 000002                         rlba      =+2                 ; bus address
      99 000004                         rlda      =+4                 ; disk address
     100 000006                         rlmp      =+6                 ; multipurpose
     101                                
     102 000004                         cmstat    =2*2                ; get status
     103 000006                         cmseek    =3*2                ; seek
     104 000010                         cmrdhd    =4*2                ; read header
     105 000014                         cmrdda    =6*2                ; read data
     106                                
     107 173220 012701  174400          rlgo:    mov   #rlcsr,r1
     108 173224 010003                           mov   r0,r3          ; save unit number
     109 173226 000303                           swab  r3             ; unit number in upper byte
     110 173230 010311                           mov   r3,(r1)        ; set unit, NOP cmd
     111                                
     112 173232 012761  000013  000004           mov   #013,rlda(r1)  ; subcmd reset+getstatus
     113 173240 052703  000004                   bis   #cmstat,r3     ; get status cmd (r3lo is 0)
     114 173244 010311                           mov   r3,(r1)        ; execute
     115 173246 105711                  1$:      tstb  (r1)           ; test for ready
     116 173250 100376                           bpl   1$             ; wait
     117                                
     118 173252 105003                           clrb  r3             ; unit number in upper byte
     119 173254 052703  000010                   bis   #cmrdhd,r3     ; read header cmd
     120 173260 010311                           mov   r3,(r1)        ; execute
     121 173262 105711                  2$:      tstb  (r1)           ; test for ready
     122 173264 100376                           bpl   2$             ; wait
     123                                
     124 173266 016102  000006                   mov   rlmp(r1),r2    ; retrieve cyl/head/sector
     125 173272 042702  000077                   bic   #77,r2         ; set sector to zero
     126 173276 005202                           inc   r2             ; set head 0, seek to cyl 0
     127 173300 010261  000004                   mov   r2,rlda(r1)    ; into da for seek
     128 173304 105003                           clrb  r3             ; unit number in upper byte
     129 173306 052703  000006                   bis   #cmseek,r3     ; seek cmd
     130 173312 010311                           mov   r3,(r1)        ; execute
     131 173314 105711                  3$:      tstb  (r1)           ; test for ready
     132 173316 100376                           bpl   3$             ; wait
     133                                
     134 173320 005061  000004                   clr   rlda(r1)       ; select cyl0/head0/sector0
     135 173324 012761  177000  000006           mov   #-512.,rlmp(r1)      ; set word count
     136 173332 105003                           clrb  r3             ; unit number in upper byte
     137 173334 052703  000014                   bis   #cmrdda,r3     ; read data cmd
     138 173340 010311                           mov   r3,(r1)        ; execute
     139 173342 105711                  4$:      tstb  (r1)           ; test for ready
     140 173344 100376                           bpl   4$             ; wait
     141                                
     142 173346 005711                           tst   (r1)           ; test for error
     143 173350 100002                           bpl   5$             ; br if ok
     144 173352 000005                           reset                ; ERROR - reset the world
     145 173354 000721                           br rlgo              ; retry
     146                                
     147 173356 042711  000377          5$:      bic   #377,(r1)      ; execute nop cmd
     148 173362 005007                           clr   pc             ; jump to bootstrap at zero
     149                                
     150                                ; --------------------------------------------------
     151                                ; rk
     152                                ; --------------------------------------------------
     153                                
     154 177400                         rkcsr    =177400              ; std RK03/05 DECdisk csrbase
     155                                
     156 000002                         rkwc     =+6-4                ; word count
     157 000004                         rkba     =+10-4               ; bus address
     158 000006                         rkda     =+12-4               ; disk address
     159                                
     160 177340                         tccsr    =177340              ; std TU55/56 DECtape csrbase
     161                                
     162 177776                         tccs     =+0-2                ; control/status
     163 000002                         tcwc     =+4-2                ; word count
     164                                
     165 000002                         xxwc     =rkwc                ; common word count offset
     166                                
     167 165564                         diags    =165564              ; console diags phase2 entry
     168                                
     169                                
     170 173364 012701  177404          rkgo:    mov   #rkcsr+4,r1    ; boot std csr, unit <R0>
     171 173370 005061  000004                   clr   rkba(r1)       ; clear bus address
     172 173374 010003                           mov   r0,r3          ; get unit number
     173 173376 000241                           clc                  ; C=0 for ror
     174 173400 006003                           ror   r3             ; shift into 15:12
     175 173402 006003                           ror   r3             ;
     176 173404 006003                           ror   r3             ;
     177 173406 006003                           ror   r3             ;
     178 173410 010361  000006                   mov   r3,rkda(r1)    ; unit number, sector 0 to disk addr
     179                                
     180 173414 012761  177000  000002  common:  mov   #-512.,xxwc(r1)   ; set word count
     181 173422 052703  000005                   bis   #5,r3          ; command READ+GO
     182 173426 010311                           mov   r3,(r1)        ; execute
     183 173430 105711                  2$:      tstb  (r1)           ; test ready
     184 173432 100376                           bpl   2$             ; loop
     185                                
     186 173434 005711                           tst   (r1)           ; check error
     187 173436 100002                           bpl   3$             ; br if no error
     188                                
     189 173440 000005                           reset                ; reset the world
     190 173442 000750                           br rkgo              ; and retry
     191                                
     192 173444 042711  000377          3$:      bic   #377,(r1)      ; nop command
     193 173450 005007                           clr   pc             ; jump to loaded boot sector
     194                                
     195                                
     196                                ; --------------------------------------------------
     197                                ; rp
     198                                ; --------------------------------------------------
     199                                
     200 176700                         rmcsr    =176700              ; std RH11 csrbase
     201                                
     202 000000                         rpcs  =+0                     ; control status offset
     203 000002                         rpwc  =+2                     ; word count offset
     204 000004                         rpba  =+4                     ; bus addr offset
     205 000010                         rpcs2 =+10                    ; control status 2 offset
     206 000016                         rpas  =+16                    ; atten summary offset
     207 000032                         rpof  =+32                    ; offset register offset
     208                                
     209                                
     210 173452 012701  176700          rpgo:    mov   #rmcsr,r1      ; boot std csr, unit <R0>
     211                                
     212 173456 010061  000010                   mov   r0,rpcs2(r1)   ; set unit number into controller
     213 173462 012702  000071                   mov   #071,r2        ; READ+GO command code
     214 173466 012711  000021                   mov   #021,(r1)      ; RIP+GO command
     215 173472 012761  014000  000032           mov   #014000,rpof(r1)  ; set 16b mode, inhibit ECC mode
     216 173500 016161  000016  000016           mov   rpas(r1),rpas(r1) ; clear attention bits
     217                                
     218 173506 012761  177000  000002           mov   #-512.,rpwc(r1)      ; set word count
     219 173514 011103                           mov   (r1),r3        ; get unit number
     220 173516 042703  000377                   bic   #377,r3        ; clear command byte
     221 173522 050203                           bis   r2,r3          ; insert read command code
     222 173524 010311                           mov   r3,(r1)        ; execute read command
     223 173526 105711                  2$:      tstb  (r1)           ; test unit ready
     224 173530 100376                           bpl   2$             ; br if not yet
     225                                
     226 173532 005711                           tst   (r1)           ; test any error
     227 173534 100002                           bpl   3$             ; br if not
     228                                
     229 173536 000005                           reset                ; error, reset the world
     230 173540 000744                           br rpgo              ; and jump back to restart
     231                                
     232 173542 042711  000377          3$:      bic   #377,(r1)      ; nop command, clear controller
     233 173546 005007                           clr   pc             ; jump to bootstrap start
     234                                
     235                                
     236                                ;
     237                                ; prtascz
     238                                ; r1 - return address
     239                                ; r2 - pointer to asciz string
     240                                ;
     241                                prtascz:
     242                                $10:
     243 173550 105737  177564                   tstb  @#177564
     244 173554 100375                           bpl   $10
     245 173556 105712                           tstb  (r2)
     246 173560 001403                           beq   $20
     247 173562 112237  177566                   movb  (r2)+,@#177566
     248 173566 000770                           br    $10
     249                                $20:
     250 173570 000161  000002                   jmp   2(r1)
     251                                ;
     252                                ; prtoct
     253                                ;
     254                                ; R0 = register value to print
     255                                ; R1 = return address
     256                                ; R2 = temp char
     257                                ; R3 = temp addr
     258                                
     259 173574 012702  000030          prtoct:  mov   #<'0/bit1>,r2  ; ascii 0 right 1b
     260 173600 000261                           sec                  ; shift a 1 into R0 lsb as done bit
     261 173602 006100                  1$:      rol   r0             ; msb out of R0
     262 173604 106102                           rolb  r2             ; into lsb of R2
     263 173606 010703                           mov   pc,r3          ; ret addr
     264 173610 105737  177564                   tstb  @#177564
     265 173614 100375                           bpl   .-4
     266 173616 110237  177566                   movb  r2,@#177566
     267 173622 012702  020206                   mov   #<BL*bit8>+200+<'0/bit3>,r2 ; ascii SP upper, ascii 0 right 3b lower
     268 173626 006300                  2$:      asl   r0             ; msb out of R0
     269 173630 001403                           beq   3$             ; when R0 has gone to zero we are done
     270 173632 106102                           rolb  r2             ; into lsb of R2
     271 173634 103774                           bcs   2$             ; loop once more if flagbit was set
     272 173636 000761                           br    1$             ; go get last bit and print char
     273                                3$:
     274 173640 000161  000002                   jmp   2(r1)          ; return
